{
  "$schema": "https://dl.viam.dev/module.schema.json",
  "module_id": "viam:arm-pack",
  "visibility": "public",
  "url": "https://github.com/viam-labs/arm-pack",
  "description": "Robot arm building blocks: an action-sequence generic service and a dial-driven arm jogging service",
  "models": [
    {
      "api": "rdk:service:generic",
      "model": "viam:arm-pack:action-sequence-service",
      "short_description": "Runs a configured sequence of gripper and saved-position actions when triggered via DoCommand.",
      "markdown_link": "README.md#model-viamarm-packaction-sequence-service"
    },
    {
      "api": "rdk:service:generic",
      "model": "viam:arm-pack:dial-control-motion",
      "short_description": "Translates dial inputs into relative arm translations and rotations, with speed-based acceleration.",
      "markdown_link": "README.md#model-viamarm-packdial-control-motion"
    }
  ],
  "applications": null,
  "markdown_link": "README.md",
  "entrypoint": "bin/arm-pack",
  "first_run": "",
  "build": {
    "build": "make module.tar.gz",
    "setup": "make setup",
    "path": "module.tar.gz",
    "arch": [
      "linux/amd64",
      "linux/arm64",
      "darwin/arm64",
      "windows/amd64"
    ]
  }
}
